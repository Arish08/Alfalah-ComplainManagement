# ------------------------------------------------------------
# Environment files
#
# Ignore real environment files containing machine-specific
# configuration or secrets.
# ------------------------------------------------------------

.env
.env.*
**/.env
**/.env.*

# Allow safe templates to be committed
!.env.example
!**/.env.example


